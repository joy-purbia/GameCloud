<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#0a051b"/>
      <stop offset="60%" stop-color="#1e0b36"/>
      <stop offset="100%" stop-color="#05070f"/>
    </linearGradient>
    <linearGradient id="sun" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#f43f5e"/>
      <stop offset="100%" stop-color="#f59e0b"/>
    </linearGradient>
    <linearGradient id="car" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#06b6d4"/>
      <stop offset="100%" stop-color="#8b5cf6"/>
    </linearGradient>
  </defs>
  <rect width="600" height="400" fill="url(#bg)"/>
  <!-- Synthwave Sun -->
  <circle cx="300" cy="200" r="90" fill="url(#sun)"/>
  <line x1="200" y1="180" x2="400" y2="180" stroke="#0a051b" stroke-width="4"/>
  <line x1="210" y1="200" x2="390" y2="200" stroke="#0a051b" stroke-width="5"/>
  <line x1="225" y1="220" x2="375" y2="220" stroke="#0a051b" stroke-width="6"/>
  <line x1="240" y1="240" x2="360" y2="240" stroke="#0a051b" stroke-width="7"/>
  <!-- Perspective Road -->
  <polygon points="270,220 330,220 540,400 60,400" fill="#0b0e17"/>
  <line x1="270" y1="220" x2="60" y2="400" stroke="#06b6d4" stroke-width="4"/>
  <line x1="330" y1="220" x2="540" y2="400" stroke="#06b6d4" stroke-width="4"/>
  <line x1="300" y1="220" x2="300" y2="400" stroke="#ec4899" stroke-width="4" stroke-dasharray="15,15"/>
  <!-- Cyber Car Outline -->
  <polygon points="260,330 340,330 365,370 235,370" fill="url(#car)"/>
  <polygon points="275,315 325,315 335,330 265,330" fill="#06b6d4" opacity="0.8"/>
  <line x1="245" y1="365" x2="355" y2="365" stroke="#f43f5e" stroke-width="4"/>
  <!-- Text -->
  <text x="300" y="80" text-anchor="middle" font-family="'Orbitron', sans-serif" font-size="34" font-weight="900" fill="#38bdf8" letter-spacing="4">NEON RACER 3D</text>
  <text x="300" y="110" text-anchor="middle" font-family="'Rajdhani', sans-serif" font-size="16" font-weight="700" fill="#a855f7" letter-spacing="3">THREE.JS / WEBGL</text>
</svg>
